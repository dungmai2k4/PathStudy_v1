# ================================================================
# PathStudy Platform - Production Environment Variables
# Copy file này thành .env trên máy chủ VPS: cp .env.prod.example .env
# ================================================================

# ===== Database PostgreSQL =====
DB_USERNAME=postgres
DB_PASSWORD=ChangeThisToAStrongPassword123!

# ===== JWT Security (Tối thiểu 32 ký tự / 256 bits) =====
JWT_SECRET=PathStudySecureJwtSecretKeyWithAtLeast256BitsLengthForProduction2026!
JWT_EXPIRATION_MS=86400000

# ===== Tên Miền / CORS Production =====
CORS_ALLOWED_ORIGIN_PROD=https://your-domain.com

# ===== VietQR Banking Configuration (Dành cho Payment Service) =====
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=NGUYEN VAN A
VIETQR_TEMPLATE=compact2

# ===== Webhook Token (Bảo mật Webhook nhận thanh toán tự động) =====
PAYMENT_WEBHOOK_TOKEN=your_ultra_secret_webhook_token_here
