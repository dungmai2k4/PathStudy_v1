# =====================================================
# PathStudy Platform - Environment Variables Template
# =====================================================
# Copy this file to .env in each service directory
# and fill in your actual values.
#
# NEVER commit .env files with real values to Git!
# =====================================================

# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ===== JWT =====
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000 // 86400000ms <=> 24h

# ===== Eureka =====
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# ===== API Gateway =====
GATEWAY_PORT=8088
CORS_ALLOWED_ORIGIN_PROD=https://your-production-domain.com

# ===== VietQR Payment (payment-service only) =====
VIETQR_BANK_ID=your_bank_id
VIETQR_ACCOUNT_NO=your_account_number
VIETQR_ACCOUNT_NAME=your_account_name
VIETQR_TEMPLATE=compact2

# ===== Payment Webhook (payment-service only) =====
PAYMENT_WEBHOOK_TOKEN=your_secure_webhook_token

# ===== Service URLs =====
AUTH_SERVICE_URL=http://localhost:8081
CONTENT_SERVICE_URL=http://localhost:8082
QUESTION_SERVICE_URL=http://localhost:8083
ASSESSMENT_SERVICE_URL=http://localhost:8084
